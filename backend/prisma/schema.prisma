datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────
// 1. 門市、總倉與開關帳 (Stores, Warehouses & Sessions - iCHEF Z-Report)
// ─────────────────────────────────────────────────────────────

enum StoreType {
  RETAIL      // 實體零售門市 (竹北店、金山店)
  WAREHOUSE   // 中央總倉 / 物流倉
  POPUP       // 展場 / 快閃專櫃
}

model Store {
  id               String                 @id // "chupei" | "jinshan" | "warehouse-main"
  name             String                 // "竹北店" | "金山店" | "中央總倉"
  code             String                 @unique
  type             StoreType              @default(RETAIL)
  address          String?
  phone            String?
  isActive         Boolean                @default(true)
  openTime         String?                // "14:00"
  standardHours    Int                    @default(8)
  lateGraceMinutes Int                    @default(15)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  inventories       StoreInventory[]
  inventoryLogs     InventoryLog[]
  stocktakes        Stocktake[]
  sessions          CashRegisterSession[]
  orders            Order[]
  luckyBags         LuckyBag[]
  attendances       Attendance[]
  schedules         Schedule[]
  shiftSchedules    ShiftSchedule[]
  attendanceRecords AttendanceRecord[]
  transfersOut      TransferOrder[]       @relation("SourceStore")
  transfersIn       TransferOrder[]       @relation("TargetStore")

  @@map("stores")
}

enum SessionStatus {
  OPEN
  CLOSED
}

model CashRegisterSession {
  id             String        @id @default(uuid())
  storeId        String        @map("store_id")
  openedAt       DateTime      @default(now()) @map("opened_at")
  closedAt       DateTime?     @map("closed_at")
  openedBy       String        @map("opened_by")
  closedBy       String?       @map("closed_by")
  
  // 零錢備金與實盤現金
  openingCash    Int           @default(0) @map("opening_cash")
  expectedCash   Int?          @map("expected_cash") // openingCash + cashRevenue
  actualCash     Int?          @map("actual_cash")   // 店員實盤抽屜現金
  discrepancy    Int?          @map("discrepancy")   // 溢短 (actual - expected)

  // Z-Report 財務審計快照 (關帳時計算並固化)
  totalRevenue   Int?          @default(0) @map("total_revenue")
  cashRevenue    Int?          @default(0) @map("cash_revenue")
  cardRevenue    Int?          @default(0) @map("card_revenue")
  remitRevenue   Int?          @default(0) @map("remit_revenue")
  pointsIssued   Int?          @default(0) @map("points_issued")
  pointsRedeemed Int?          @default(0) @map("points_redeemed")
  txCount        Int?          @default(0) @map("tx_count")
  voidCount      Int?          @default(0) @map("void_count")
  voidAmount     Int?          @default(0) @map("void_amount")

  note           String?
  status         SessionStatus @default(OPEN)

  store          Store         @relation(fields: [storeId], references: [id])
  orders         Order[]

  @@index([storeId, status])
  @@map("cash_register_sessions")
}

// ─────────────────────────────────────────────────────────────
// 2. 跨店調撥管理 (Inter-store Transfers & In-Transit Tracking)
// ─────────────────────────────────────────────────────────────

enum TransferStatus {
  DRAFT       // 草稿待出庫
  DISPATCHED  // 已出庫 (在途 In-Transit)
  RECEIVED    // 已驗收入庫完成
  CANCELLED   // 已作廢撤銷
}

model TransferOrder {
  id            String              @id @default(uuid())
  transferNo    String              @unique @map("transfer_no") // 調撥單號 TR-YYYYMMDD-XXXX
  sourceStoreId String              @map("source_store_id")
  targetStoreId String              @map("target_store_id")
  status        TransferStatus      @default(DRAFT)
  dispatchedAt  DateTime?           @map("dispatched_at")
  receivedAt    DateTime?           @map("received_at")
  dispatchedBy  String?             @map("dispatched_by")
  receivedBy    String?             @map("received_by")
  note          String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  sourceStore   Store               @relation("SourceStore", fields: [sourceStoreId], references: [id])
  targetStore   Store               @relation("TargetStore", fields: [targetStoreId], references: [id])
  items         TransferOrderItem[]

  @@index([sourceStoreId, status])
  @@index([targetStoreId, status])
  @@map("transfer_orders")
}

model TransferOrderItem {
  id           String        @id @default(uuid())
  transferId   String        @map("transfer_id")
  productId    String        @map("product_id")
  requestedQty Int           @map("requested_qty")
  shippedQty   Int           @default(0) @map("shipped_qty")
  receivedQty  Int           @default(0) @map("received_qty")
  remark       String?

  transfer     TransferOrder @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])

  @@unique([transferId, productId])
  @@map("transfer_order_items")
}

// ─────────────────────────────────────────────────────────────
// 3. 會員主檔、點數帳本與經營指標 (Members & Loyalty)
// ─────────────────────────────────────────────────────────────

model Member {
  id             String     @id @default(uuid())
  phone          String     @unique // 唯一電話，支援去前導 0 查詢
  barcode        String?    @unique // 實體會員卡條碼
  lineUserId     String?    @unique @map("line_user_id") // LINE 官方帳號綁定 UID
  name           String
  tier           String     @default("GENERAL") // VIP | GOLD | GENERAL
  gender         String?
  birthday       String?    // "yyyy/MM/dd"
  registeredAt   DateTime   @default(now()) @map("registered_at")
  points         Int        @default(0) // 當前有效點數 (永久有效)
  version        Int        @default(0) // 樂觀鎖版本號
  note           String?
  isActive       Boolean    @default(true) @map("is_active")

  // 📈 會員營運與商務累計指標 (免除全表掃描)
  totalSpent     Int        @default(0) @map("total_spent")
  orderCount     Int        @default(0) @map("order_count")
  lastPurchaseAt DateTime?  @map("last_purchase_at")

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  pointLogs      PointLog[]
  orders         Order[]

  @@index([phone])
  @@index([lineUserId])
  @@map("members")
}

enum PointLogType {
  EARN
  REDEEM
  REFUND
  MANUAL
}

model PointLog {
  id        String       @id @default(uuid())
  memberId  String       @map("member_id")
  type      PointLogType
  delta     Int          // +10 / -50
  balance   Int          // 異動後結餘
  orderId   String?      @map("order_id")
  reason    String?
  operator  String?
  createdAt DateTime     @default(now()) @map("created_at")

  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@map("point_logs")
}

// ─────────────────────────────────────────────────────────────
// 4. 商品分類、品相規格與跨店庫存 (Categories, Products & Inventory)
// ─────────────────────────────────────────────────────────────

model Category {
  id        String     @id @default(uuid())
  name      String     // 分類名稱 (如: GK雕像、景品、盒玩、寶可夢)
  code      String?    @unique // 分類代碼
  parentId  String?    @map("parent_id") // 支援樹狀母子層級目錄
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@index([parentId])
  @@map("categories")
}

enum ProductCondition {
  NEW             // 全新未拆
  DISPLAY_OPENED  // 拆擺無損
  BOX_DAMAGED     // 盒損特價
  SECOND_HAND     // 二手有瑕
}

enum ProductCategory {
  GENERAL
  GK
  BLIND_BOX
}

model Product {
  id               String              @id // 貨號
  barcode          String?             @unique // 條碼
  name             String
  categoryId       String?             @map("category_id")
  category         String              @default("GENERAL") // 維持向下相容舊字串
  brand            String?             // 品牌 (萬代/MegaHouse/集模堂)
  series           String?             // 系列 (MASTERLISE/POP/景品)
  condition        ProductCondition    @default(NEW)
  costPrice        Int                 @default(0) @map("cost_price")
  sellingPrice     Int                 @default(0) @map("selling_price")
  suggestedPoints  Int                 @default(0) @map("suggested_points")
  version          Int                 @default(0) // 樂觀鎖版本號
  isSpecial        Boolean             @default(false) @map("is_special") // 88888/99999
  remark           String?
  parentId         String?             @map("parent_id") // SPU/SKU 母商品關聯
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  categoryRel      Category?           @relation(fields: [categoryId], references: [id])
  parentProduct    Product?            @relation("ProductVariants", fields: [parentId], references: [id])
  variants         Product[]           @relation("ProductVariants")
  storeInventories StoreInventory[]
  inventoryLogs    InventoryLog[]
  stocktakeItems   StocktakeItem[]
  orderItems       OrderItem[]
  luckyBagPrizes   LuckyBagPrize[]
  transferItems    TransferOrderItem[]

  @@index([category])
  @@index([categoryId])
  @@index([parentId])
  @@index([condition])
  @@index([createdAt])
  @@map("products")
}

model StoreInventory {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  productId    String   @map("product_id")
  quantity     Int      @default(0)
  safetyStock  Int      @default(0) @map("safety_stock")
  version      Int      @default(0) // 樂觀鎖版本號
  updatedAt    DateTime @updatedAt

  store        Store    @relation(fields: [storeId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
  @@map("store_inventories")
}

enum InventoryChangeType {
  SALE                // 結帳出庫
  SALE_VOID_RETURN    // 作廢入庫回補
  STOCKTAKE_ADJUST    // 盤盈盤虧調整
  MANUAL_ADJUST       // 人工進貨/損耗
  TRANSFER_OUT        // 調撥出庫
  TRANSFER_IN         // 調撥入庫
}

model InventoryLog {
  id          String              @id @default(uuid())
  storeId     String              @map("store_id")
  productId   String              @map("product_id")
  changeType  InventoryChangeType @map("change_type")
  delta       Int                 // 異動數量 (+2 / -1)
  balance     Int                 // 異動後結存
  orderId     String?             @map("order_id")
  stocktakeId String?             @map("stocktake_id")
  operator    String?
  reason      String?
  createdAt   DateTime            @default(now()) @map("created_at")

  store       Store               @relation(fields: [storeId], references: [id])
  product     Product             @relation(fields: [productId], references: [id])

  @@index([storeId, productId])
  @@index([createdAt])
  @@map("inventory_logs")
}

enum StocktakeStatus {
  DRAFT
  POSTED    // 已審核過帳
  CANCELLED
}

model Stocktake {
  id         String          @id @default(uuid())
  storeId    String          @map("store_id")
  status     StocktakeStatus @default(DRAFT)
  countedBy  String          @map("counted_by")
  postedBy   String?         @map("posted_by")
  postedAt   DateTime?       @map("posted_at")
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt

  store      Store           @relation(fields: [storeId], references: [id])
  items      StocktakeItem[]

  @@map("stocktakes")
}

model StocktakeItem {
  id          String    @id @default(uuid())
  stocktakeId String    @map("stocktake_id")
  productId   String    @map("product_id")
  systemQty   Int       @map("system_qty")   // 盤點時系統數
  actualQty   Int       @map("actual_qty")   // 門市實盤數
  variance    Int       // actualQty - systemQty (盤盈/盤虧)
  itemRemark  String?   @map("item_remark")

  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([stocktakeId, productId])
  @@map("stocktake_items")
}

// ─────────────────────────────────────────────────────────────
// 5. 一番賞與福袋開套模型 (Lucky Bags & Prizes)
// ─────────────────────────────────────────────────────────────

enum LuckyBagStatus {
  ACTIVE
  DEPLETED
  VOIDED
}

model LuckyBag {
  id          String          @id
  storeId     String          @map("store_id")
  name        String
  unitPrice   Int             @default(0) @map("unit_price")
  isPointsSet Boolean         @default(false) @map("is_points_set")
  status      LuckyBagStatus  @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt

  store       Store           @relation(fields: [storeId], references: [id])
  prizes      LuckyBagPrize[]
  orderItems  OrderItem[]

  @@map("lucky_bags")
}

model LuckyBagPrize {
  id         String   @id @default(uuid())
  bagId      String   @map("bag_id")
  prizeGrade String   @map("prize_grade")
  prizeName  String   @map("prize_name")
  productId  String?  @map("product_id")
  points     Int      @default(0)
  draws      Int      @default(1)
  drawnCount Int      @default(0) @map("drawn_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt

  bag        LuckyBag @relation(fields: [bagId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([bagId])
  @@map("lucky_bag_prizes")
}

// ─────────────────────────────────────────────────────────────
// 6. 銷售訂單、複合付款與折扣 (Orders & Multi-tender Payments)
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  COMPLETED
  CANCELLED
}

model Order {
  id             String              @id @default(uuid())
  checkoutUID    String              @unique @map("checkout_uid") // 結帳冪等鍵
  storeId        String              @map("store_id")
  sessionId      String              @map("session_id")
  memberId       String?             @map("member_id")
  status         OrderStatus         @default(COMPLETED)
  
  totalDue       Int                 @default(0) @map("total_due")
  receivedAmount Int                 @default(0) @map("received_amount")

  // 💳 複合付款與促銷折扣 JSON 擴充 (高吞吐、零 Join、彈性支援街口/悠遊卡/LINE Pay 複合付款)
  payments       Json?               // 範例: [{ method: "LINE_PAY", amount: 500, ref: "LP-123" }, { method: "CASH", amount: 300 }]
  discounts      Json?               // 範例: [{ type: "VIP", amount: 50, note: "VIP 9折" }]

  // 向下相容既有平鋪欄位
  cash           Int                 @default(0)
  creditCard     Int                 @default(0) @map("credit_card")
  linePay        Int                 @default(0) @map("line_pay")
  remittance     Int                 @default(0)
  pointsUsed     Int                 @default(0) @map("points_used")
  netPointsDelta Int                 @default(0) @map("net_points_delta")

  cashierEmail   String              @map("cashier_email")
  orderNote      String?             @map("order_note")
  voidReason     String?             @map("void_reason")
  voidedAt       DateTime?           @map("voided_at")
  voidedBy       String?             @map("voided_by")

  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt

  store          Store               @relation(fields: [storeId], references: [id])
  session        CashRegisterSession @relation(fields: [sessionId], references: [id])
  member         Member?             @relation(fields: [memberId], references: [id])
  items          OrderItem[]
  pointLogs      PointLog[]

  @@index([storeId, createdAt])
  @@index([sessionId])
  @@index([memberId])
  @@map("orders")
}

enum OrderItemType {
  LOTTERY
  MERCHANDISE
  SPECIAL
}

enum DrawPickType {
  TAKE_AWAY
  POINTS
}

model OrderItem {
  id           String        @id @default(uuid())
  orderId      String        @map("order_id")
  itemType     OrderItemType @map("item_type")

  bagId        String?       @map("bag_id")
  prizeGrade   String?       @map("prize_grade")
  prizeName    String?       @map("prize_name")
  pickType     DrawPickType? @map("pick_type")
  draws        Int?          @default(1)

  productId    String?       @map("product_id")
  quantity     Int           @default(1)
  unitPrice    Int           @default(0) @map("unit_price")
  amount       Int           @default(0)
  pointsImpact Int           @default(0) @map("points_impact")
  remark       String?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  luckyBag     LuckyBag?     @relation(fields: [bagId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// 7. 營運支援、排班考勤與人員 (Operations, Schedules & Attendance)
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  STORE_MANAGER
  CASHIER
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  role            Role      @default(CASHIER)
  assignedStoreId String?   @map("assigned_store_id")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("users")
}

model Schedule {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  date      String
  staffName String   @map("staff_name")
  isClosed  Boolean  @default(false) @map("is_closed")

  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, date])
  @@map("schedules")
}

model ShiftSchedule {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  date        String   // "YYYY-MM-DD"
  staffName   String   @map("staff_name")
  staffEmail  String?  @map("staff_email")
  shiftType   String   @default("FULL") @map("shift_type")
  isClosed    Boolean  @default(false) @map("is_closed")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, date])
  @@map("shift_schedules")
}

model Attendance {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  userEmail  String    @map("user_email")
  clockInAt  DateTime  @default(now()) @map("clock_in_at")
  clockOutAt DateTime? @map("clock_out_at")
  status     String    @default("NORMAL")

  store      Store     @relation(fields: [storeId], references: [id])

  @@map("attendances")
}

enum AttendanceStatus {
  NORMAL
  LATE
  EARLY_LEAVE
  ABSENT
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  storeId     String           @map("store_id")
  userEmail   String           @map("user_email")
  userName    String?          @map("user_name")
  clockInAt   DateTime         @default(now()) @map("clock_in_at")
  clockOutAt  DateTime?        @map("clock_out_at")
  status      AttendanceStatus @default(NORMAL)
  lateMinutes Int              @default(0) @map("late_minutes")
  ipAddress   String?          @map("ip_address")
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at")

  store       Store            @relation(fields: [storeId], references: [id])

  @@index([storeId, clockInAt])
  @@map("attendance_records")
}

// ─────────────────────────────────────────────────────────────
// 8. 外部整合與可靠發信匣 (Integrations & Transactional Outbox)
// ─────────────────────────────────────────────────────────────

model IntegrationConfig {
  id          String   @id @default(uuid())
  key         String   @unique // "LINE_NOTIFY" | "TRELLO_BOARD" | "STORE_HOURS"
  value       Json
  description String?
  isEnabled   Boolean  @default(true) @map("is_enabled")
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integration_configs")
}

enum OutboxTaskType {
  LINE_SHIFT_CLOSED
  LINE_ORDER_VOIDED
  LINE_LATE_ALERT
  TRELLO_GK_CARD
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model OutboxTask {
  id          String         @id @default(uuid())
  taskType    OutboxTaskType @map("task_type")
  payload     Json
  status      OutboxStatus   @default(PENDING)
  retryCount  Int            @default(0) @map("retry_count")
  maxRetries  Int            @default(5) @map("max_retries")
  lastError   String?        @map("last_error")
  nextRetryAt DateTime       @default(now()) @map("next_retry_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  processedAt DateTime?      @map("processed_at")

  @@index([status, nextRetryAt])
  @@map("outbox_tasks")
}

// ─────────────────────────────────────────────────────────────
// 9. POS 即時廣播緊急公告 (Emergency Notice)
// ─────────────────────────────────────────────────────────────

enum NoticeLevel {
  INFO
  WARNING
  CRITICAL
}

model EmergencyNotice {
  id             String      @id @default(uuid())
  title          String
  content        String
  level          NoticeLevel @default(INFO)
  targetStoreIds String[]    @map("target_store_ids")
  isActive       Boolean     @default(true) @map("is_active")
  version        Int         @default(1)
  publisherEmail String      @map("publisher_email")
  publishedAt    DateTime    @default(now()) @map("published_at")
  expiresAt      DateTime?   @map("expires_at")

  @@index([isActive])
  @@map("emergency_notices")
}

// ─────────────────────────────────────────────────────────────
// 10. 一番賞廢套與殘值損益紀錄 (Void Set Logs)
// ─────────────────────────────────────────────────────────────

model VoidSetLog {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  bagId          String   @map("bag_id")
  bagName        String   @map("bag_name")
  unitPrice      Int      @map("unit_price")
  totalDraws     Int      @map("total_draws")
  drawnCount     Int      @map("drawn_count")
  realizedIncome Int      @default(0) @map("realized_income")
  totalCost      Int      @default(0) @map("total_cost")
  residualValue  Int      @default(0) @map("residual_value")
  netProfitLoss  Int      @default(0) @map("net_profit_loss")
  restoredItems  Json?    @map("restored_items")
  isPointsSet    Boolean  @default(false) @map("is_points_set")
  details        String
  operator       String
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("void_set_logs")
}

// ─────────────────────────────────────────────────────────────
// 11. 防竄改雜湊鏈審計日誌 (Tamper-evident Audit Logs)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  operatorId  String   @map("operator_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  delta       Float?
  reason      String
  ipAddress   String?  @map("ip_address")
  prevHash    String?  @map("prev_hash")
  currentHash String   @map("current_hash")
  createdAt   DateTime @default(now())      @map("created_at")

  @@index([targetType, targetId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("audit_logs")
}
